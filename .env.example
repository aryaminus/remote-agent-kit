# ─────────────────────────────────────────────────────────────────
# remote-agent-kit — operator secrets. Copy to `.env`, fill in, NEVER commit.
#   cp .env.example .env && chmod 600 .env
#
# Every value here is injected at deploy time (Terraform vars / Ansible
# extra-vars / cloud-init). The repo ships placeholders only — repo_check.sh
# fails CI if anything looking like a real secret lands in git.
# ─────────────────────────────────────────────────────────────────

# Hetzner Cloud API token (https://console.hetzner.cloud → Security → API Tokens,
# read+write). Used by Terraform AND `make ssh` inventory lookup.
HCLOUD_TOKEN=CHANGEME-hetzner-cloud-api-token

# Tailscale auth key (https://login.tailscale.com/admin/authkeys → reusable,
# expiry 90d, tags optional). Treat like a password; rotate after first deploy.
TAILSCALE_AUTHKEY=tskey-auth-CHANGEME

# Telegram bot token from @BotFather (/newbot). Polling mode — no inbound ports.
TELEGRAM_BOT_TOKEN=CHANGEME-telegram-bot-token
# Your numeric Telegram user id from @userinfobot (NOT your @handle).
# Only these ids may talk to the bot. Comma-separated for more than one.
TELEGRAM_ALLOWED_USERS=CHANGEME-numeric-id

# Model provider. Nous Portal uses OAuth (no key here); OpenRouter/Anthropic
# need a key which the deploy writes to the gateway env on the server only.
#   MODEL_PROVIDER=nous | openrouter | anthropic
MODEL_PROVIDER=nous
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Gateway API server key for the Perch phone client. If empty, the deploy
# generates `hp_<43 chars>` and prints where to find it (server only).
# This key is a full agent shell — the pairing QR carries it.
API_SERVER_KEY=

# Optional: ntfy topic for push approvals (https://ntfy.sh). Blank = off.
# Requires the perch-approvals hook plugin (ansible role `perch` installs it).
NTFY_TOPIC=

# Optional: exact origin of your Perch web build (for browser CORS).
# Native apps need nothing. Example: https://perch.pages.dev
PERCH_WEB_ORIGIN=
