# ─────────────────────────────────────────────────────────────────
# remote-agent-kit — operator secrets. Copy to `.env`, fill in, NEVER commit.
#   cp .env.example .env && chmod 600 .env
#
# Every value here is injected at deploy time (Terraform vars / Ansible
# extra-vars / cloud-init). The repo ships placeholders only — repo_check.sh
# fails CI if anything looking like a real secret lands in git.
# ─────────────────────────────────────────────────────────────────

# Hetzner Cloud API token (https://console.hetzner.cloud → Security → API Tokens,
# read+write). Used by Terraform AND `make ssh` inventory lookup.
HCLOUD_TOKEN=CHANGEME-hetzner-cloud-api-token

# Tailscale auth key (https://login.tailscale.com/admin/authkeys → reusable,
# expiry 90d, tags optional). Treat like a password; rotate after first deploy.
TAILSCALE_AUTHKEY=tskey-auth-CHANGEME

# Telegram is OFF unless both lines below are filled (polling mode — no
# inbound ports). Bot token from @BotFather (/newbot); numeric user id from
# @userinfobot (NOT your @handle). Only these ids may talk to the bot.
# Comma-separated for more than one. Leave both blank = no bot, gateway
# still starts for the API/phone app.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id from @userinfobot (NOT your @handle).
TELEGRAM_ALLOWED_USERS=

# Model provider. Nous Portal uses OAuth (no key here); OpenRouter/Anthropic
# need a key which the deploy writes to the gateway env on the server only.
#   MODEL_PROVIDER=nous | openrouter | anthropic
MODEL_PROVIDER=nous
# OpenCode reads OPENROUTER_API_KEY natively in login shells; Z.AI + Zen
# entries are auto-wired into opencode's auth.json by deploy (see usage.md §3).
OPENROUTER_API_KEY=
# Real Anthropic key (optional). When set, disables the Z.AI→Claude bridge
# below so actual Anthropic billing is never hijacked.
ANTHROPIC_API_KEY=
# Z.AI/GLM key — powers THREE lanes: opencode `zai/*` (PAYG wallet),
# opencode `zai-coding-plan/*` (GLM Coding Plan subscription), and Claude
# Code itself via Z.AI's Anthropic-compatible endpoint (automatic when
# ANTHROPIC_API_KEY is unset).
ZAI_API_KEY=
# CommandCode key — powers `cmd` headless AND opencode providers
# (commandcode/* + commandcode-claude/*, catalog auto-fetched at deploy).
COMMANDCODE_API_KEY=
# OpenAI key for `codex` CLI fallback (device login is the default path).
OPENAI_API_KEY=

# OpenCode Zen (opencode.ai/auth → "sk-..." key): native provider auth for
# `opencode run` without extra flags. Prefer this over pasting other
# providers' keys into the Zen picker (wrong-key-in-Zen-slot fails as
# "Invalid API key" at call time, not at login).
OPENCODE_API_KEY=

# OpenCode model routing (verified live on this kit):
# - Zen's DEFAULT endpoint may answer "no tool-capable endpoint" — pass an
#   explicit model:  opencode run --model <id> "do X"
# - Free-model route that works headless: --model openrouter/<free-id>
#   (e.g. anthropic/claude-sonnet-4); Zen free GLM ids resolve under
#   `opencode/<model>` and zai/* under a configured Z.AI key.

# Gateway API server key for the Perch phone client (hp_ + 43 chars).
# scripts/start.sh generates it once; Ansible refuses to guess (a rotated
# key locks out paired phones). This key is a full agent shell — the
# pairing QR carries it.
API_SERVER_KEY=

# Dashboard sign-in (Perch app) + stable session token. Generated once by
# scripts/start.sh — NEVER rotate casually: rotation silently unpairs phones.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
HERMES_DASHBOARD_SESSION_TOKEN=

# Optional: ntfy topic for push approvals (https://ntfy.sh). Blank = off.
# Requires the perch-approvals hook plugin (ansible role `perch` installs it).
NTFY_TOPIC=

# Optional: exact origin of your Perch web build (for browser CORS).
# Native apps need nothing. Example: https://perch.pages.dev
PERCH_WEB_ORIGIN=

# Optional: git commit identity used on the box. The email becomes public
# metadata on push — a GitHub noreply address is the safer choice.
GIT_AUTHOR_EMAIL=
